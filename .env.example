
VITE_SUPABASE_URL=https://your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Chiave del BROWSER (pubblica per natura): ristretta per sito e per API in console Google. Mai usata dalle funzioni.
# La chiave del SERVER e' il secret GOOGLE_SERVER_KEY di Supabase (non va qui). Per `npm run dev` (specchio del proxy) metti GOOGLE_SERVER_KEY o GOOGLE_MAPS_API_KEY in .env.local.
# Passi e restrizioni: docs/prove/2026-11-06-google-chiavi.md
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_MAP_ID=your_google_map_id
# Map ID dello stile Google «Unnivai · Ossidiana Navigazione» (assegnato alla modalità buio del Map ID; non è un segreto ma sta solo qui e su Vercel, mai nel codice). Se manca, la navigazione usa VITE_GOOGLE_MAP_ID.
VITE_GOOGLE_MAP_ID_NAV=28861a61c07876f889cc6572
# Colore per fascia oraria durante la navigazione (un Map ID per fascia, stile assegnato alla modalita' buio). Se una manca, si resta su Ossidiana.
# mattina: fino a 2 h dopo l'alba; tramonto: da 1 h prima a 30 min dopo il tramonto; notte: dal buio all'alba. Alba e tramonto veri del posto.
VITE_GOOGLE_MAP_ID_NAV_MATTINA=
VITE_GOOGLE_MAP_ID_NAV_TRAMONTO=
VITE_GOOGLE_MAP_ID_NAV_NOTTE=
